# Copy this file to .env.local and paste your keys from Supabase → Settings → API
# Restart `npm run dev` after creating or editing .env.local (NEXT_PUBLIC_* is inlined at startup).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy JWT anon key works too if publishable is unavailable:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
