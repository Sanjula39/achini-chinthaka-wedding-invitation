# Copy to .env.local. Restart `npm run dev` after edits.

# Recommended for production (RSVP uses POST /api/rsvp — reads these on the server at runtime):
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# Same values also work if you prefer — must redeploy on Vercel after changing:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
